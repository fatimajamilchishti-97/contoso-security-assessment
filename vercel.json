{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/dashboard", "destination": "/public/dashboard.html" },
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/mobile-risks", "destination": "/server.js" },
    { "source": "/infrastructure", "destination": "/server.js" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
