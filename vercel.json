{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/dashboard", "destination": "/public/dashboard.html" },
    { "source": "/api/(.*)", "destination": "/server.js?apiName=$1" },
    { "source": "/mobile-risks", "destination": "/server.js?apiName=mobile-risks" },
    { "source": "/infrastructure", "destination": "/server.js?apiName=infrastructure" },
    { "source": "/css/(.*)", "destination": "/public/css/$1" },
    { "source": "/js/(.*)", "destination": "/public/js/$1" }
  ]
}
